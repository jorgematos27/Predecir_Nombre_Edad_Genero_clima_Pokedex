{
  "expo": {
    "name": "Couteau",
    "slug": "couteau-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/mifoto.jpg",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,

    "android": {
      "package": "com.jorgem27.couteau",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "backgroundColor": "#000000"
      }
    },

    "web": {
      "favicon": "./assets/images/mifoto.jpg"
    },

    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],

    "extra": {
      "eas": {
        "projectId": "ec4dd71c-89a1-409b-90d9-f7560f18de10"
      }
    }
  }
}
